# Mizan API — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Railway PostgreSQL — Railway injects DATABASE_URL automatically.
# For local dev, use a local Postgres or Railway dev database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mizan

# JWT secret — must be at least 32 characters
JWT_SECRET=change-me-in-production-must-be-32-chars!!

# Python scan engine integration
# Local: python -m mizan_scan
# Railway worker: http://scan-engine.railway.internal/run
SCAN_ENGINE_CMD=python -m mizan_scan
