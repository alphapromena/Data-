# Mizan Scan Engine — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# Target data source DSN (the client's database to profile)
# This is NOT the Mizan platform database — it's the client's data source.
TARGET_PG_DSN=postgresql://user:password@host:5432/client_database

# Max rows to sample per table (default: 100000)
SAMPLE_SIZE=100000
