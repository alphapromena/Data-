# Mizan Scan Engine — environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# Target Postgres source (the client's database being profiled, NOT Supabase)
TARGET_PG_DSN=postgresql://user:password@host:5432/dbname

# Supabase (used to push scan results back via service role)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: limit profiling
SAMPLE_SIZE=100000
SCHEMAS=public
